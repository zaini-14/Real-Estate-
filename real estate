/* =========================================
   HAVENNEST PROPERTIES
   STYLE.CSS
========================================= */


/* =========================================
   1. ROOT VARIABLES
========================================= */

:root {

    --primary: #1f2925;
    --primary-light: #2d3934;

    --accent: #b38a5d;
    --accent-dark: #956f47;
    --accent-light: #d3b38c;

    --cream: #f7f4ee;
    --cream-dark: #eee9df;

    --white: #ffffff;

    --text-dark: #202522;
    --text: #5d625f;
    --text-light: #8b908c;

    --border: #e5e1d9;

    --shadow-sm: 0 8px 25px rgba(31, 41, 37, 0.07);
    --shadow-md: 0 15px 45px rgba(31, 41, 37, 0.12);
    --shadow-lg: 0 25px 70px rgba(31, 41, 37, 0.18);

    --radius-sm: 8px;
    --radius-md: 14px;
    --radius-lg: 22px;

    --transition: 0.35s ease;

    --container: 1180px;
}


/* =========================================
   2. RESET
========================================= */

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
    scroll-padding-top: 90px;
}

body {
    font-family: "DM Sans", sans-serif;
    color: var(--text-dark);
    background: var(--white);
    line-height: 1.6;
    overflow-x: hidden;
}

body.modal-open {
    overflow: hidden;
}

img {
    display: block;
    width: 100%;
}

button,
input,
select,
textarea {
    font: inherit;
}

button {
    cursor: pointer;
    border: none;
}

a {
    color: inherit;
    text-decoration: none;
}

ul {
    list-style: none;
}


/* =========================================
   3. GENERAL
========================================= */

.container {
    width: min(92%, var(--container));
    margin: 0 auto;
}

.section-padding {
    padding: 110px 0;
}

.section-label {
    display: inline-block;

    margin-bottom: 14px;

    color: var(--accent);

    font-size: 0.78rem;
    font-weight: 700;

    letter-spacing: 2px;
    text-transform: uppercase;
}

.section-heading {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;

    gap: 40px;

    margin-bottom: 55px;
}

.section-heading.centered {
    display: block;
    text-align: center;

    max-width: 760px;
    margin-left: auto;
    margin-right: auto;
}

.section-heading h2 {
    max-width: 650px;

    font-family: "Playfair Display", serif;

    font-size: clamp(2rem, 4vw, 3.2rem);
    font-weight: 600;

    line-height: 1.15;

    color: var(--primary);
}

.section-heading h2 span {
    color: var(--accent);
}

.section-heading > p,
.section-heading.centered > p {
    max-width: 460px;

    color: var(--text);

    font-size: 0.98rem;
}

.section-heading.centered > p {
    margin: 20px auto 0;
}


/* =========================================
   4. BUTTONS
========================================= */

.btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;

    gap: 12px;

    min-height: 52px;

    padding: 0 25px;

    border-radius: 5px;

    font-size: 0.88rem;
    font-weight: 700;

    transition: var(--transition);
}

.btn i {
    transition: transform var(--transition);
}

.btn:hover i {
    transform: translateX(4px);
}

.btn-primary {
    color: var(--white);
    background: var(--accent);
}

.btn-primary:hover {
    background: var(--accent-dark);
    transform: translateY(-2px);
}

.btn-outline {
    color: var(--white);
    border: 1px solid rgba(255, 255, 255, 0.55);
    background: rgba(255, 255, 255, 0.08);
    backdrop-filter: blur(5px);
}

.btn-outline:hover {
    color: var(--primary);
    background: var(--white);
    border-color: var(--white);
}

.btn-dark {
    color: var(--white);
    background: var(--primary);
}

.btn-dark:hover {
    background: var(--accent);
    transform: translateY(-2px);
}

.outline-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;

    gap: 12px;

    padding: 14px 24px;

    border: 1px solid var(--primary);
    border-radius: 5px;

    color: var(--primary);
    background: transparent;

    font-size: 0.86rem;
    font-weight: 700;

    transition: var(--transition);
}

.outline-btn i {
    transition: transform var(--transition);
}

.outline-btn:hover {
    color: var(--white);
    background: var(--primary);
}

.outline-btn:hover i {
    transform: translateX(4px);
}


/* =========================================
   5. HEADER
========================================= */

.header {
    position: fixed;

    top: 0;
    left: 0;

    width: 100%;

    z-index: 1000;

    padding: 22px 0;

    transition: var(--transition);
}

.header.scrolled {
    padding: 13px 0;

    background: rgba(255, 255, 255, 0.96);

    box-shadow: 0 5px 25px rgba(0, 0, 0, 0.07);

    backdrop-filter: blur(12px);
}

.nav-container {
    display: flex;
    align-items: center;

    justify-content: space-between;
}


/* Logo */

.logo {
    display: inline-flex;
    align-items: center;

    gap: 10px;

    color: var(--white);

    font-family: "Playfair Display", serif;

    font-size: 1.45rem;
    font-weight: 700;
}

.logo > span:last-child > span {
    color: var(--accent-light);
}

.logo-icon {
    display: grid;
    place-items: center;

    width: 38px;
    height: 38px;

    border: 1px solid rgba(255, 255, 255, 0.4);
    border-radius: 50%;

    font-size: 0.9rem;

    transition: var(--transition);
}

.logo:hover .logo-icon {
    background: var(--accent);
    border-color: var(--accent);

    transform: rotate(-8deg);
}

.header.scrolled .logo {
    color: var(--primary);
}

.header.scrolled .logo-icon {
    border-color: var(--accent);
}

.header.scrolled .logo > span:last-child > span {
    color: var(--accent);
}


/* Navbar */

.navbar {
    display: flex;
    align-items: center;

    gap: 34px;
}

.nav-link {
    position: relative;

    color: rgba(255, 255, 255, 0.85);

    font-size: 0.84rem;
    font-weight: 500;

    transition: var(--transition);
}

.nav-link::after {
    content: "";

    position: absolute;

    left: 0;
    bottom: -8px;

    width: 0;
    height: 2px;

    background: var(--accent);

    transition: var(--transition);
}

.nav-link:hover,
.nav-link.active {
    color: var(--white);
}

.nav-link:hover::after,
.nav-link.active::after {
    width: 100%;
}

.header.scrolled .nav-link {
    color: var(--text);
}

.header.scrolled .nav-link:hover,
.header.scrolled .nav-link.active {
    color: var(--primary);
}


/* Nav Button */

.nav-button {
    padding: 11px 19px;

    border: 1px solid rgba(255, 255, 255, 0.5);
    border-radius: 4px;

    color: var(--white);

    font-size: 0.78rem;
    font-weight: 700;

    transition: var(--transition);
}

.nav-button:hover {
    color: var(--primary);
    background: var(--white);
}

.header.scrolled .nav-button {
    color: var(--primary);
    border-color: var(--primary);
}

.header.scrolled .nav-button:hover {
    color: var(--white);
    background: var(--primary);
}


/* Mobile Toggle */

.menu-toggle {
    display: none;

    width: 42px;
    height: 42px;

    border-radius: 5px;

    color: var(--white);
    background: transparent;

    font-size: 1.2rem;
}

.header.scrolled .menu-toggle {
    color: var(--primary);
}


/* =========================================
   6. HERO
========================================= */

.hero {
    position: relative;

    min-height: 760px;

    display: flex;
    align-items: center;

    background-image:
        url("https://images.unsplash.com/photo-1600585154340-be6161a56a0c?auto=format&fit=crop&w=2000&q=90");

    background-size: cover;
    background-position: center;

    color: var(--white);
}

.hero-overlay {
    position: absolute;

    inset: 0;

    background:
        linear-gradient(
            90deg,
            rgba(15, 21, 18, 0.85) 0%,
            rgba(15, 21, 18, 0.62) 42%,
            rgba(15, 21, 18, 0.25) 100%
        );
}

.hero-content {
    position: relative;

    z-index: 2;

    max-width: 760px;

    padding-top: 70px;
}

.hero-tag {
    display: inline-flex;
    align-items: center;

    gap: 9px;

    margin-bottom: 22px;

    color: var(--accent-light);

    font-size: 0.78rem;
    font-weight: 700;

    letter-spacing: 1.5px;
    text-transform: uppercase;
}

.hero-tag i {
    color: var(--accent-light);
}

.hero h1 {
    max-width: 720px;

    margin-bottom: 25px;

    font-family: "Playfair Display", serif;

    font-size: clamp(3rem, 7vw, 5.8rem);
    font-weight: 500;

    line-height: 1.02;

    letter-spacing: -2px;
}

.hero h1 span {
    display: block;

    color: var(--accent-light);
}

.hero-content > p {
    max-width: 590px;

    margin-bottom: 35px;

    color: rgba(255, 255, 255, 0.82);

    font-size: 1rem;
}

.hero-buttons {
    display: flex;
    flex-wrap: wrap;

    gap: 13px;
}


/* =========================================
   7. SEARCH SECTION
========================================= */

.search-section {
    position: relative;

    z-index: 10;

    margin-top: -80px;
}

.search-box {
    padding: 30px;

    background: var(--white);

    border-radius: var(--radius-md);

    box-shadow: var(--shadow-lg);
}

.search-heading {
    margin-bottom: 25px;
}

.search-heading span {
    display: block;

    margin-bottom: 4px;

    color: var(--primary);

    font-family: "Playfair Display", serif;

    font-size: 1.45rem;
    font-weight: 600;
}

.search-heading p {
    color: var(--text);

    font-size: 0.82rem;
}

.property-search {
    display: grid;

    grid-template-columns:
        1.1fr
        1.1fr
        0.9fr
        1.1fr
        auto;

    gap: 12px;
}

.search-field {
    padding: 0 14px;

    border-right: 1px solid var(--border);
}

.search-field label {
    display: block;

    margin-bottom: 5px;

    color: var(--text-light);

    font-size: 0.7rem;
    font-weight: 700;

    letter-spacing: 0.5px;
    text-transform: uppercase;
}

.field-input {
    display: flex;
    align-items: center;

    gap: 9px;
}

.field-input i {
    color: var(--accent);

    font-size: 0.85rem;
}

.field-input select {
    width: 100%;

    border: none;
    outline: none;

    color: var(--primary);

    background: transparent;

    font-size: 0.84rem;

    cursor: pointer;
}

.search-btn {
    display: flex;
    align-items: center;
    justify-content: center;

    gap: 9px;

    min-width: 120px;

    border-radius: 5px;

    color: var(--white);
    background: var(--primary);

    font-size: 0.82rem;
    font-weight: 700;

    transition: var(--transition);
}

.search-btn:hover {
    background: var(--accent);

    transform: translateY(-2px);
}


/* =========================================
   8. PROPERTIES
========================================= */

.properties-section {
    background: var(--white);
}

.property-grid {
    display: grid;

    grid-template-columns: repeat(3, 1fr);

    gap: 25px;
}

.property-card {
    overflow: hidden;

    background: var(--white);

    border: 1px solid var(--border);
    border-radius: var(--radius-md);

    transition: var(--transition);
}

.property-card:hover {
    border-color: transparent;

    box-shadow: var(--shadow-md);

    transform: translateY(-7px);
}

.property-card.hidden {
    display: none;
}

.property-image {
    position: relative;

    height: 260px;

    overflow: hidden;
}

.property-image img {
    height: 100%;

    object-fit: cover;

    transition: transform 0.7s ease;
}

.property-card:hover .property-image img {
    transform: scale(1.06);
}

.property-badge {
    position: absolute;

    top: 16px;
    left: 16px;

    padding: 6px 11px;

    border-radius: 3px;

    color: var(--white);
    background: var(--accent);

    font-size: 0.67rem;
    font-weight: 700;

    text-transform: uppercase;
    letter-spacing: 0.7px;
}

.property-badge.luxury {
    background: var(--primary);
}

.property-badge.commercial-badge {
    background: #5c695f;
}

.favorite-btn {
    position: absolute;

    top: 15px;
    right: 15px;

    display: grid;
    place-items: center;

    width: 38px;
    height: 38px;

    border-radius: 50%;

    color: var(--primary);
    background: rgba(255, 255, 255, 0.92);

    transition: var(--transition);
}

.favorite-btn:hover {
    color: var(--white);
    background: var(--accent);

    transform: scale(1.08);
}

.favorite-btn.active {
    color: var(--white);
    background: var(--accent);
}

.property-content {
    padding: 24px;
}

.property-type {
    display: inline-block;

    margin-bottom: 8px;

    color: var(--accent);

    font-size: 0.68rem;
    font-weight: 700;

    letter-spacing: 1px;
    text-transform: uppercase;
}

.property-content h3 {
    margin-bottom: 8px;

    color: var(--primary);

    font-family: "Playfair Display", serif;

    font-size: 1.35rem;
    font-weight: 600;
}

.property-location {
    display: flex;
    align-items: center;

    gap: 6px;

    margin-bottom: 20px;

    color: var(--text-light);

    font-size: 0.76rem;
}

.property-location i {
    color: var(--accent);
}

.property-details {
    display: flex;
    align-items: center;

    gap: 14px;

    padding: 15px 0;

    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
}

.property-details span {
    display: flex;
    align-items: center;

    gap: 5px;

    color: var(--text);

    font-size: 0.7rem;
}

.property-details i {
    color: var(--accent);
}

.property-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;

    gap: 15px;

    padding-top: 18px;
}

.property-bottom strong {
    color: var(--primary);

    font-size: 1rem;
}

.view-property {
    display: inline-flex;
    align-items: center;

    gap: 7px;

    color: var(--accent);
    background: transparent;

    font-size: 0.72rem;
    font-weight: 700;

    transition: var(--transition);
}

.view-property i {
    transition: transform var(--transition);
}

.view-property:hover {
    color: var(--accent-dark);
}

.view-property:hover i {
    transform: translateX(4px);
}

.properties-footer {
    display: flex;
    justify-content: center;

    margin-top: 50px;
}


/* =========================================
   9. CATEGORIES
========================================= */

.categories-section {
    background: var(--cream);
}

.category-grid {
    display: grid;

    grid-template-columns: repeat(4, 1fr);

    gap: 18px;
}

.category-card {
    position: relative;

    height: 390px;

    overflow: hidden;

    border-radius: var(--radius-md);
}

.category-card::after {
    content: "";

    position: absolute;

    inset: 0;

    background:
        linear-gradient(
            to top,
            rgba(15, 21, 18, 0.78),
            rgba(15, 21, 18, 0.02) 65%
        );
}

.category-card img {
    height: 100%;

    object-fit: cover;

    transition: transform 0.7s ease;
}

.category-card:hover img {
    transform: scale(1.07);
}

.category-overlay {
    position: absolute;

    right: 22px;
    bottom: 22px;
    left: 22px;

    z-index: 2;

    color: var(--white);
}

.category-overlay span {
    color: var(--accent-light);

    font-size: 0.68rem;
    font-weight: 600;
}

.category-overlay h3 {
    margin-top: 3px;

    font-family: "Playfair Display", serif;

    font-size: 1.55rem;
}

.category-overlay i {
    position: absolute;

    right: 0;
    bottom: 4px;

    display: grid;
    place-items: center;

    width: 38px;
    height: 38px;

    border: 1px solid rgba(255, 255, 255, 0.45);
    border-radius: 50%;

    font-size: 0.75rem;

    transition: var(--transition);
}

.category-card:hover .category-overlay i {
    color: var(--primary);
    background: var(--white);
    border-color: var(--white);

    transform: rotate(-45deg);
}


/* =========================================
   10. FEATURES
========================================= */

.features-section {
    background: var(--white);
}

.features-grid {
    display: grid;

    grid-template-columns: repeat(4, 1fr);

    gap: 20px;
}

.feature-card {
    padding: 35px 28px;

    border: 1px solid var(--border);
    border-radius: var(--radius-md);

    transition: var(--transition);
}

.feature-card:hover {
    border-color: rgba(179, 138, 93, 0.35);

    box-shadow: var(--shadow-sm);

    transform: translateY(-5px);
}

.feature-icon {
    display: grid;
    place-items: center;

    width: 52px;
    height: 52px;

    margin-bottom: 23px;

    border-radius: 50%;

    color: var(--accent);
    background: var(--cream);

    font-size: 1.15rem;

    transition: var(--transition);
}

.feature-card:hover .feature-icon {
    color: var(--white);
    background: var(--accent);

    transform: rotate(-8deg);
}

.feature-card h3 {
    margin-bottom: 10px;

    color: var(--primary);

    font-family: "Playfair Display", serif;

    font-size: 1.25rem;
}

.feature-card p {
    color: var(--text);

    font-size: 0.82rem;
}


/* =========================================
   11. ABOUT
========================================= */

.about-section {
    background: var(--cream);
}

.about-grid {
    display: grid;

    grid-template-columns: 1fr 1fr;

    align-items: center;

    gap: 90px;
}

.about-images {
    position: relative;

    min-height: 590px;
}

.about-main-image {
    position: absolute;

    top: 0;
    left: 0;

    width: 78%;
    height: 470px;

    overflow: hidden;

    border-radius: var(--radius-md);
}

.about-main-image img {
    height: 100%;

    object-fit: cover;
}

.about-small-image {
    position: absolute;

    right: 0;
    bottom: 0;

    width: 48%;
    height: 260px;

    overflow: hidden;

    border: 8px solid var(--cream);

    border-radius: var(--radius-md);
}

.about-small-image img {
    height: 100%;

    object-fit: cover;
}

.about-experience {
    position: absolute;

    left: 20px;
    bottom: 35px;

    display: flex;
    align-items: center;

    gap: 12px;

    padding: 17px 20px;

    border-radius: 6px;

    color: var(--white);
    background: var(--primary);

    box-shadow: var(--shadow-md);
}

.about-experience strong {
    color: var(--accent-light);

    font-family: "Playfair Display", serif;

    font-size: 2rem;
}

.about-experience span {
    font-size: 0.72rem;
    line-height: 1.35;
}

.about-content h2 {
    margin-bottom: 23px;

    color: var(--primary);

    font-family: "Playfair Display", serif;

    font-size: clamp(2rem, 4vw, 3.1rem);
    font-weight: 600;

    line-height: 1.15;
}

.about-content h2 span {
    color: var(--accent);
}

.about-content > p {
    margin-bottom: 16px;

    color: var(--text);

    font-size: 0.9rem;
}

.about-stats {
    display: flex;

    gap: 45px;

    margin: 32px 0;
}

.about-stats div {
    display: flex;
    flex-direction: column;
}

.about-stats strong {
    color: var(--primary);

    font-family: "Playfair Display", serif;

    font-size: 1.75rem;
}

.about-stats span {
    color: var(--text-light);

    font-size: 0.7rem;
}


/* =========================================
   12. AGENTS
========================================= */

.agents-section {
    background: var(--white);
}

.agents-grid {
    display: grid;

    grid-template-columns: repeat(3, 1fr);

    gap: 25px;
}

.agent-card {
    overflow: hidden;

    background: var(--white);

    border: 1px solid var(--border);
    border-radius: var(--radius-md);

    transition: var(--transition);
}

.agent-card:hover {
    box-shadow: var(--shadow-md);

    transform: translateY(-6px);
}

.agent-image {
    position: relative;

    height: 380px;

    overflow: hidden;
}

.agent-image img {
    height: 100%;

    object-fit: cover;

    object-position: center top;

    transition: transform 0.7s ease;
}

.agent-card:hover .agent-image img {
    transform: scale(1.04);
}

.agent-socials {
    position: absolute;

    right: 18px;
    bottom: 18px;

    display: flex;

    gap: 7px;
}

.agent-socials a {
    display: grid;
    place-items: center;

    width: 35px;
    height: 35px;

    border-radius: 50%;

    color: var(--primary);
    background: var(--white);

    font-size: 0.72rem;

    transition: var(--transition);
}

.agent-socials a:hover {
    color: var(--white);
    background: var(--accent);
}

.agent-content {
    padding: 21px 23px;
}

.agent-content h3 {
    margin-bottom: 4px;

    color: var(--primary);

    font-family: "Playfair Display", serif;

    font-size: 1.25rem;
}

.agent-content span {
    color: var(--text-light);

    font-size: 0.72rem;
}


/* =========================================
   13. TESTIMONIALS
========================================= */

.testimonials-section {
    background: var(--primary);

    color: var(--white);
}

.testimonials-section .section-label {
    color: var(--accent-light);
}

.testimonials-section .section-heading h2 {
    color: var(--white);
}

.testimonial-slider {
    max-width: 850px;

    margin: 0 auto;
}

.testimonial-track {
    position: relative;

    min-height: 300px;
}

.testimonial {
    display: none;

    padding: 10px 30px;

    text-align: center;
}

.testimonial.active {
    display: block;

    animation: testimonialFade 0.5s ease;
}

@keyframes testimonialFade {

    from {
        opacity: 0;
        transform: translateY(15px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }

}

.quote-icon {
    display: grid;
    place-items: center;

    width: 55px;
    height: 55px;

    margin: 0 auto 25px;

    border-radius: 50%;

    color: var(--accent-light);
    background: rgba(179, 138, 93, 0.13);

    font-size: 1.2rem;
}

.testimonial > p {
    max-width: 720px;

    margin: 0 auto 28px;

    color: rgba(255, 255, 255, 0.85);

    font-family: "Playfair Display", serif;

    font-size: clamp(1.3rem, 2.4vw, 1.75rem);

    line-height: 1.55;
}

.testimonial-author {
    display: flex;
    align-items: center;
    justify-content: center;

    gap: 11px;
}

.author-avatar {
    display: grid;
    place-items: center;

    width: 42px;
    height: 42px;

    border-radius: 50%;

    color: var(--white);
    background: var(--accent);

    font-size: 0.7rem;
    font-weight: 700;
}

.testimonial-author div:last-child {
    display: flex;
    flex-direction: column;

    text-align: left;
}

.testimonial-author strong {
    color: var(--white);

    font-size: 0.78rem;
}

.testimonial-author span {
    color: rgba(255, 255, 255, 0.5);

    font-size: 0.65rem;
}

.slider-controls {
    display: flex;
    align-items: center;
    justify-content: center;

    gap: 20px;

    margin-top: 15px;
}

.slider-btn {
    display: grid;
    place-items: center;

    width: 40px;
    height: 40px;

    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 50%;

    color: var(--white);
    background: transparent;

    font-size: 0.72rem;

    transition: var(--transition);
}

.slider-btn:hover {
    color: var(--primary);
    background: var(--white);
}

.slider-dots {
    display: flex;

    gap: 7px;
}

.dot {
    width: 7px;
    height: 7px;

    padding: 0;

    border-radius: 50%;

    background: rgba(255, 255, 255, 0.25);

    transition: var(--transition);
}

.dot.active {
    width: 23px;

    border-radius: 10px;

    background: var(--accent);
}


/* =========================================
   14. CONTACT
========================================= */

.contact-section {
    background: var(--cream);
}

.contact-grid {
    display: grid;

    grid-template-columns: 0.85fr 1.15fr;

    gap: 80px;

    align-items: center;
}

.contact-content h2 {
    margin-bottom: 22px;

    color: var(--primary);

    font-family: "Playfair Display", serif;

    font-size: clamp(2.1rem, 4vw, 3.2rem);

    line-height: 1.15;
}

.contact-content h2 span {
    color: var(--accent);
}

.contact-content > p {
    max-width: 480px;

    margin-bottom: 35px;

    color: var(--text);

    font-size: 0.9rem;
}

.contact-info {
    display: flex;
    flex-direction: column;

    gap: 22px;
}

.contact-item {
    display: flex;
    align-items: center;

    gap: 15px;
}

.contact-icon {
    display: grid;
    place-items: center;

    width: 45px;
    height: 45px;

    flex-shrink: 0;

    border-radius: 50%;

    color: var(--accent);
    background: var(--white);

    box-shadow: var(--shadow-sm);
}

.contact-item > div:last-child {
    display: flex;
    flex-direction: column;
}

.contact-item span {
    color: var(--text-light);

    font-size: 0.67rem;
}

.contact-item strong {
    color: var(--primary);

    font-size: 0.78rem;
}


/* Contact Form */

.contact-form-wrapper {
    padding: 40px;

    border-radius: var(--radius-md);

    background: var(--white);

    box-shadow: var(--shadow-md);
}

.contact-form {
    display: flex;
    flex-direction: column;

    gap: 20px;
}

.form-row {
    display: grid;

    grid-template-columns: 1fr 1fr;

    gap: 18px;
}

.form-group {
    display: flex;
    flex-direction: column;

    gap: 7px;
}

.form-group label {
    color: var(--primary);

    font-size: 0.72rem;
    font-weight: 700;
}

.form-group input,
.form-group select,
.form-group textarea {
    width: 100%;

    padding: 13px 15px;

    border: 1px solid var(--border);
    border-radius: 5px;

    outline: none;

    color: var(--primary);
    background: var(--white);

    font-size: 0.8rem;

    transition: var(--transition);
}

.form-group input::placeholder,
.form-group textarea::placeholder {
    color: #a9ada9;
}

.form-group input:focus,
.form-group select:focus,
.form-group textarea:focus {
    border-color: var(--accent);

    box-shadow: 0 0 0 3px rgba(179, 138, 93, 0.1);
}

.form-group textarea {
    resize: vertical;

    min-height: 120px;
}

.form-submit {
    width: fit-content;

    margin-top: 4px;
}

.form-message {
    display: none;

    padding: 11px 14px;

    border-radius: 5px;

    font-size: 0.75rem;
}

.form-message.success {
    display: block;

    color: #356046;
    background: #e7f3ea;
}

.form-message.error {
    display: block;

    color: #8a3f3f;
    background: #f8e8e8;
}


/* =========================================
   15. PROPERTY MODAL
========================================= */

.property-modal {
    position: fixed;

    inset: 0;

    z-index: 2000;

    display: flex;
    align-items: center;
    justify-content: center;

    padding: 25px;

    visibility: hidden;
    opacity: 0;

    transition:
        opacity 0.35s ease,
        visibility 0.35s ease;
}

.property-modal.active {
    visibility: visible;
    opacity: 1;
}

.modal-overlay {
    position: absolute;

    inset: 0;

    background: rgba(10, 14, 12, 0.8);

    backdrop-filter: blur(5px);
}

.modal-content {
    position: relative;

    z-index: 2;

    display: grid;

    grid-template-columns: 0.95fr 1.05fr;

    width: min(100%, 950px);

    max-height: 90vh;

    overflow: auto;

    border-radius: var(--radius-md);

    background: var(--white);

    box-shadow: var(--shadow-lg);

    transform: translateY(25px) scale(0.98);

    transition: transform 0.35s ease;
}

.property-modal.active .modal-content {
    transform: translateY(0) scale(1);
}

.modal-close {
    position: absolute;

    top: 15px;
    right: 15px;

    z-index: 5;

    display: grid;
    place-items: center;

    width: 38px;
    height: 38px;

    border-radius: 50%;

    color: var(--primary);
    background: var(--white);

    box-shadow: var(--shadow-sm);

    transition: var(--transition);
}

.modal-close:hover {
    color: var(--white);
    background: var(--accent);

    transform: rotate(90deg);
}

.modal-image {
    position: relative;

    min-height: 550px;

    background: #ddd;
}

.modal-image > img {
    height: 100%;

    object-fit: cover;
}

.modal-image-controls {
    position: absolute;

    right: 18px;
    bottom: 18px;

    display: flex;

    gap: 8px;
}

.modal-image-controls button {
    display: grid;
    place-items: center;

    width: 38px;
    height: 38px;

    border-radius: 50%;

    color: var(--primary);
    background: var(--white);

    transition: var(--transition);
}

.modal-image-controls button:hover {
    color: var(--white);
    background: var(--accent);
}

.modal-details {
    display: flex;
    flex-direction: column;

    justify-content: center;

    padding: 50px;
}

.modal-details h2 {
    margin-bottom: 7px;

    color: var(--primary);

    font-family: "Playfair Display", serif;

    font-size: 2.2rem;

    line-height: 1.15;
}

.modal-details .property-location {
    margin-bottom: 22px;
}

.modal-price {
    margin-bottom: 22px;

    color: var(--accent);

    font-family: "Playfair Display", serif;

    font-size: 1.5rem;
    font-weight: 600;
}

.modal-property-details {
    display: grid;

    grid-template-columns: repeat(2, 1fr);

    gap: 10px;

    margin-bottom: 25px;
}

.modal-detail-item {
    padding: 13px;

    border-radius: 5px;

    background: var(--cream);
}

.modal-detail-item span {
    display: block;

    margin-bottom: 3px;

    color: var(--text-light);

    font-size: 0.62rem;
    text-transform: uppercase;
}

.modal-detail-item strong {
    color: var(--primary);

    font-size: 0.8rem;
}

.modal-description {
    margin-bottom: 27px;

    color: var(--text);

    font-size: 0.84rem;

    line-height: 1.8;
}

.modal-contact-btn {
    width: fit-content;
}


/* =========================================
   16. FOOTER
========================================= */

.footer {
    color: rgba(255, 255, 255, 0.7);

    background: #17201c;
}

.footer-grid {
    display: grid;

    grid-template-columns: 1.7fr 1fr 1fr 1.2fr;

    gap: 50px;

    padding: 75px 0 60px;
}

.footer-logo {
    margin-bottom: 20px;
}

.footer-brand > p {
    max-width: 280px;

    margin-bottom: 23px;

    color: rgba(255, 255, 255, 0.5);

    font-size: 0.78rem;
}

.social-links {
    display: flex;

    gap: 8px;
}

.social-links a {
    display: grid;
    place-items: center;

    width: 35px;
    height: 35px;

    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 50%;

    color: rgba(255, 255, 255, 0.7);

    font-size: 0.7rem;

    transition: var(--transition);
}

.social-links a:hover {
    color: var(--white);
    background: var(--accent);
    border-color: var(--accent);
}

.footer-column {
    display: flex;
    flex-direction: column;

    gap: 11px;
}

.footer-column h4 {
    margin-bottom: 8px;

    color: var(--white);

    font-family: "Playfair Display", serif;

    font-size: 1rem;
}

.footer-column a {
    width: fit-content;

    color: rgba(255, 255, 255, 0.5);

    font-size: 0.72rem;

    transition: var(--transition);
}

.footer-column a:hover {
    color: var(--accent-light);

    transform: translateX(3px);
}

.footer-bottom {
    border-top: 1px solid rgba(255, 255, 255, 0.08);
}

.footer-bottom .container {
    display: flex;
    align-items: center;
    justify-content: space-between;

    gap: 20px;

    padding: 20px 0;
}

.footer-bottom p {
    color: rgba(255, 255, 255, 0.35);

    font-size: 0.65rem;
}


/* =========================================
   17. SCROLL REVEAL
========================================= */

.reveal {
    opacity: 0;

    transform: translateY(35px);

    transition:
        opacity 0.7s ease,
        transform 0.7s ease;
}

.reveal.show {
    opacity: 1;

    transform: translateY(0);
}


/* =========================================
   18. RESPONSIVE - TABLET
========================================= */

@media (max-width: 1050px) {

    .navbar {
        gap: 20px;
    }

    .nav-button {
        display: none;
    }

    .property-grid {
        grid-template-columns: repeat(2, 1fr);
    }

    .category-grid {
        grid-template-columns: repeat(2, 1fr);
    }

    .features-grid {
        grid-template-columns: repeat(2, 1fr);
    }

    .about-grid {
        gap: 50px;
    }

    .contact-grid {
        gap: 50px;
    }

    .property-search {
        grid-template-columns: repeat(2, 1fr);
    }

    .search-field {
        border-right: none;
        border-bottom: 1px solid var(--border);

        padding: 12px 10px;
    }

    .search-btn {
        min-height: 50px;
    }

}


/* =========================================
   19. RESPONSIVE - MOBILE NAV
========================================= */

@media (max-width: 800px) {

    .section-padding {
        padding: 80px 0;
    }

    .header {
        padding: 15px 0;
    }

    .navbar {
        position: absolute;

        top: calc(100% + 8px);
        left: 4%;

        width: 92%;

        display: flex;
        flex-direction: column;
        align-items: stretch;

        gap: 0;

        padding: 15px;

        border-radius: 10px;

        background: var(--white);

        box-shadow: var(--shadow-lg);

        visibility: hidden;
        opacity: 0;

        transform: translateY(-10px);

        transition: var(--transition);
    }

    .navbar.active {
        visibility: visible;
        opacity: 1;

        transform: translateY(0);
    }

    .nav-link {
        padding: 13px 10px;

        color: var(--text) !important;
    }

    .nav-link::after {
        display: none;
    }

    .nav-link.active,
    .nav-link:hover {
        color: var(--accent) !important;
    }

    .menu-toggle {
        display: grid;
        place-items: center;
    }

    .hero {
        min-height: 700px;
    }

    .hero h1 {
        letter-spacing: -1px;
    }

    .section-heading {
        display: block;
    }

    .section-heading > p {
        margin-top: 18px;
    }

    .about-grid,
    .contact-grid {
        grid-template-columns: 1fr;
    }

    .about-images {
        min-height: 500px;
    }

    .contact-content {
        margin-bottom: 15px;
    }

    .footer-grid {
        grid-template-columns: repeat(2, 1fr);
    }

}


/* =========================================
   20. RESPONSIVE - SMALL MOBILE
========================================= */

@media (max-width: 600px) {

    .container {
        width: min(90%, var(--container));
    }

    .section-padding {
        padding: 70px 0;
    }

    .logo {
        font-size: 1.2rem;
    }

    .logo-icon {
        width: 33px;
        height: 33px;
    }

    .hero {
        min-height: 650px;

        background-position: 62% center;
    }

    .hero-overlay {
        background:
            linear-gradient(
                90deg,
                rgba(15, 21, 18, 0.86),
                rgba(15, 21, 18, 0.6)
            );
    }

    .hero-content {
        padding-top: 45px;
    }

    .hero h1 {
        font-size: 3rem;
    }

    .hero-content > p {
        font-size: 0.88rem;
    }

    .hero-buttons {
        flex-direction: column;
        align-items: flex-start;
    }

    .btn {
        min-height: 49px;
    }

    .search-section {
        margin-top: -55px;
    }

    .search-box {
        padding: 22px 18px;
    }

    .property-search {
        grid-template-columns: 1fr;
    }

    .search-field {
        padding: 10px 0;

        border-bottom: 1px solid var(--border);
    }

    .search-btn {
        margin-top: 8px;
    }

    .property-grid,
    .category-grid,
    .agents-grid {
        grid-template-columns: 1fr;
    }

    .features-grid {
        grid-template-columns: 1fr;
    }

    .property-image {
        height: 250px;
    }

    .category-card {
        height: 340px;
    }

    .about-images {
        min-height: 410px;
    }

    .about-main-image {
        width: 85%;
        height: 340px;
    }

    .about-small-image {
        width: 50%;
        height: 190px;
    }

    .about-experience {
        left: 10px;
        bottom: 20px;
    }

    .about-stats {
        gap: 25px;
        flex-wrap: wrap;
    }

    .agent-image {
        height: 400px;
    }

    .form-row {
        grid-template-columns: 1fr;
    }

    .contact-form-wrapper {
        padding: 25px 20px;
    }

    .footer-grid {
        grid-template-columns: 1fr;
        gap: 35px;
    }

    .footer-bottom .container {
        flex-direction: column;
        align-items: flex-start;
    }

    .modal-content {
        grid-template-columns: 1fr;

        max-height: 92vh;
    }

    .modal-image {
        min-height: 260px;
        height: 260px;
    }

    .modal-details {
        padding: 30px 24px;
    }

    .modal-details h2 {
        font-size: 1.8rem;
    }

}


/* =========================================
   21. EXTRA SMALL DEVICES
========================================= */

@media (max-width: 380px) {

    .hero h1 {
        font-size: 2.55rem;
    }

    .property-bottom {
        align-items: flex-start;
        flex-direction: column;
    }

    .property-details {
        flex-wrap: wrap;
    }

    .about-stats {
        gap: 18px;
    }

}
